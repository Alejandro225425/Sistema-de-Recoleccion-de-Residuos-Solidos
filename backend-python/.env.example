# Variables de entorno del backend Python (FastAPI)
# Copia este archivo como .env y ajusta los valores según tu entorno.

# PostgreSQL (recomendado para producción). Si se omite, el sistema usa modo memoria (demo).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sir_cusco

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex para permitir dominios de Vercel/Netlify en CORS
CORS_ORIGIN_REGEX=https://.*(\.vercel\.app|\.netlify\.app)

# Secreto JWT (usar un string robusto de al menos 32 caracteres en producción)
JWT_SECRET=change-me-to-a-strong-secret-123456

# IMPORTANTE en producción (Render):
# - DATABASE_URL se inyecta automáticamente desde la base de datos PostgreSQL provisionada en render.yaml.
# - The backend runs init_db() at startup to create schema.sql + seed.sql tables automatically.
