# Variables de entorno para producción (Vercel)
# Estas variables se configuran en el dashboard de Vercel al importar el proyecto.
# Vercel reemplazará estos valores con las variables definidas en el dashboard.
#
# Configuración de despliegue: Render (backend) + Vercel (frontend)
# - VITE_API_URL: URL de la API FastAPI en Render
# - VITE_GEO_URL: URL del servicio Geo en Render
#
# Ejemplo de valores de producción (reemplazar con URLs reales de Render):
# VITE_API_URL=https://sir-cusco-api.onrender.com/api
# VITE_GEO_URL=https://sir-cusco-geo.onrender.com

VITE_API_URL=https://sir-cusco-api.onrender.com/api
VITE_GEO_URL=https://sir-cusco-geo.onrender.com
